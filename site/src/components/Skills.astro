---
import { skills } from '../data/cv';
---

<section class="section" id="skills">
  <div class="frame">
    <span aria-hidden="true" class="tick tick-half tick--tl"></span>
    <span aria-hidden="true" class="tick tick-half tick--tr"></span>

    <div class="section-bar">
      <p class="section-bar__left hud-label">
        <span class="section-bar__num">04</span>
        <span aria-hidden="true" class="section-bar__slash">/</span>
        <span>Technical Matrix</span>
      </p>
      <p class="section-bar__right hud-label">
        {skills.length} Domains · Backend · Cloud · DevOps · AI
      </p>
    </div>

    <header class="section__intro" data-reveal>
      <h2 class="section__title">
        The kit I <span class="grad">reach for.</span>
      </h2>
      <p class="section__lede">
        Deepest in the PHP and Laravel ecosystem, now spending most of my time in applied
        LLM work — agentic systems, retrieval pipelines and the infrastructure underneath both.
      </p>
    </header>

    <div class="skills">
      {skills.map((group, i) => (
        <section class="skill cell-bar" data-reveal style={`--reveal-delay:${i * 35}ms`}>
          <div class="skill__top">
            <span class="skill__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18">
                <path fill="currentColor" d={group.icon} />
              </svg>
            </span>
            <span class="hud-label skill__idx">{String(i + 1).padStart(2, '0')}</span>
          </div>

          <h3 class="skill__title">{group.title}</h3>

          <ul class="skill__items" role="list">
            {group.items.map((item) => (
              <li class="tech-tag">{item}</li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .skills {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
  }

  .skill {
    background: var(--bg);
    padding: clamp(1.35rem, 2.2vw, 1.75rem);
    display: flex;
    flex-direction: column;
  }

  .skill__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* Exact ArtCraft 40x40 square icon box */
  .skill__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    color: var(--accent-ink);
    background: var(--bg-sunken);
  }

  .skill__idx {
    color: var(--fg-faint);
  }

  .skill__title {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink-strong);
  }

  .skill__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1rem;
  }

  @media (max-width: 1180px) {
    .skills {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .skills {
      grid-template-columns: 1fr;
    }
  }
</style>