---
import { nav, profile, socials, cvPath } from '../data/cv';

interface Props {
  /**
   * When true, in-page nav links resolve against the site root
   * (`/imerfanahmed/#about`) instead of the current document, and the brand
   * only resets scroll rather than navigating. Used by sub-pages such as the
   * blog, where a bare `#about` would go nowhere.
   */
  absolute?: boolean;
}

const { absolute = false } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const github = socials.find((s) => s.label === 'GitHub');

// On the home page prefer a real link to `/` so it works even if the URL has
// a hash; the smooth-scroll handler takes over when we're already there.
const homeHref = absolute ? `${base}/` : '#top';
const anchor = (id: string) => (absolute ? `${base}/#${id}` : `#${id}`);
---

<header class="nav" data-nav>
  <div class="nav__bar">
    <!-- Left cluster: Brand cell + Horizontal HUD links -->
    <div class="nav__left">
      <a class="nav__brand invert-block" href={homeHref} aria-label={`${profile.name} — home`}>
        <span class="nav__mark mono" aria-hidden="true">{profile.monogram}</span>
        <span class="nav__name hud-label">{profile.name}</span>
      </a>

      <nav class="nav__links" data-menu aria-label="Main">
        <ul class="nav__list">
          {nav.map((item, i) => (
            <li class="nav__item">
              <a
                href={anchor(item.id)}
                data-nav-link
                class="nav__link hud-label"
                data-section={item.id}
              >
                <span class="nav__link-pill">
                  <span class="nav__link-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  {item.label}
                </span>
              </a>
            </li>
          ))}
          <li class="nav__item">
            <a
              href={`${base}/blog/`}
              class:list={['nav__link', 'hud-label', absolute && 'is-active']}
              aria-current={absolute ? 'page' : undefined}
            >
              <span class="nav__link-pill">
                <span class="nav__link-idx" aria-hidden="true">
                  {String(nav.length + 1).padStart(2, '0')}
                </span>
                Blog
              </span>
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <!-- Right cluster: Status + GitHub square cell + Theme toggle cell + Full-height CV CTA -->
    <div class="nav__right">
      <span class="nav__status hud-label" aria-label="Availability status">
        <i class="nav__dot" aria-hidden="true"></i>
        <span>UK · AVAILABLE</span>
      </span>

      {github && (
        <a
          href={github.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile"
          title="GitHub"
          class="nav__icon-cell invert-block"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path fill="currentColor" d={github.icon} />
          </svg>
        </a>
      )}

      <button
        type="button"
        class="nav__icon-cell invert-block"
        data-theme-toggle
        aria-label="Toggle color theme"
        title="Toggle light/dark theme"
      >
        <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path>
        </svg>
      </button>

      <a class="nav__cta" href={`${base}${cvPath}`} download>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M12 17V3M6 11l6 6 6-6M19 21H5" />
        </svg>
        <span>Download CV</span>
      </a>

      <button
        class="nav__icon-cell nav__toggle invert-block"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="nav__bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="nav__progress" data-progress aria-hidden="true"></div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    left: 0;
    z-index: 200;
    width: 100%;
    height: var(--nav-h);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: blur(10px);
  }

  .nav__bar {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    height: 100%;
    width: 100%;
  }

  .nav__left {
    display: flex;
    align-items: stretch;
    min-width: 0;
  }

  /* ---- brand cell ---------------------------------------------------- */

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-inline: 1.15rem;
    border-right: 1px solid var(--line);
    color: var(--ink-strong);
    flex-shrink: 0;
  }

  .nav__mark {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1px solid currentColor;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .nav__name {
    white-space: nowrap;
    font-weight: 700;
  }

  /* ---- horizontal links ---------------------------------------------- */

  .nav__links {
    display: flex;
    align-items: stretch;
  }

  .nav__list {
    display: flex;
    align-items: stretch;
    height: 100%;
  }

  .nav__item {
    display: flex;
    align-items: stretch;
    border-right: 1px solid var(--line);
  }

  .nav__link {
    display: flex;
    align-items: center;
    padding-inline: 0.75rem;
    color: var(--fg-muted);
    white-space: nowrap;
  }

  .nav__link-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    padding: 0.2rem 0.42rem;
    transition: background-color 0.12s linear, color 0.12s linear;
  }

  .nav__link-idx {
    color: var(--fg-faint);
    font-size: 0.62rem;
  }

  .nav__link:hover .nav__link-pill,
  .nav__link.is-active .nav__link-pill {
    background: var(--invert-bg);
    color: var(--invert-fg);
  }

  .nav__link:hover .nav__link-idx,
  .nav__link.is-active .nav__link-idx {
    color: inherit;
    opacity: 0.7;
  }

  /* ---- right cells --------------------------------------------------- */

  .nav__right {
    display: flex;
    align-items: stretch;
    flex-shrink: 0;
  }

  .nav__status {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding-inline: 1rem;
    border-left: 1px solid var(--line);
    color: var(--fg-faint);
  }

  .nav__dot {
    width: 6px;
    height: 6px;
    background: var(--accent-ink);
  }

  .nav__icon-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 100%;
    border-left: 1px solid var(--line);
    color: var(--fg-muted);
  }

  :global(:root:not([data-theme='light'])) .theme-icon--moon {
    display: none;
  }

  :global(:root[data-theme='light']) .theme-icon--sun {
    display: none;
  }

  .nav__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 100%;
    padding-inline: 1.25rem;
    border-left: 1px solid var(--line);
    background: var(--invert-bg);
    color: var(--invert-fg);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: opacity 0.15s linear;
  }

  .nav__cta:hover {
    opacity: 0.82;
  }

  /* ---- mobile toggle ------------------------------------------------- */

  .nav__toggle {
    display: none;
  }

  .nav__bars {
    display: grid;
    gap: 4px;
    width: 16px;
  }

  .nav__bars i {
    height: 1.5px;
    background: currentColor;
    transition: transform 0.22s var(--ease), opacity 0.15s linear;
  }

  .nav__toggle[aria-expanded='true'] .nav__bars i:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }

  .nav__toggle[aria-expanded='true'] .nav__bars i:nth-child(2) {
    opacity: 0;
  }

  .nav__toggle[aria-expanded='true'] .nav__bars i:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  /* ---- scroll progress ----------------------------------------------- */

  .nav__progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--accent-ink);
  }

  /* ---- responsive ---------------------------------------------------- */

  @media (max-width: 1120px) {
    .nav__status {
      display: none;
    }
  }

  @media (max-width: 920px) {
    .nav__toggle {
      display: flex;
    }

    .nav__cta span {
      display: none;
    }

    .nav__cta {
      width: 48px;
      padding-inline: 0;
    }

    .nav__links {
      position: fixed;
      inset: var(--nav-h) 0 auto 0;
      background: var(--bg);
      border-bottom: 1px solid var(--line-strong);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      transition: opacity 0.2s linear, transform 0.2s var(--ease), visibility 0.2s;
    }

    .nav__links.is-open {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .nav__list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      width: 100%;
      gap: 1px;
      background: var(--line);
    }

    .nav__item {
      border-right: 0;
      background: var(--bg);
    }

    .nav__link {
      width: 100%;
      padding: 1rem 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .nav__name {
      display: none;
    }
    .nav__list {
      grid-template-columns: 1fr;
    }
  }
</style>